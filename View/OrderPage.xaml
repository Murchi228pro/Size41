<Page x:Class="_41Size.View.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_41Size.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrderPage">

    <Page.Resources>
        <Style x:Key="AuthRequired" TargetType="Button">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAuthorized}" Value="False">
                    <Setter Property="IsEnabled" Value="False"></Setter>
                    <Setter Property="Visibility" Value="Hidden"></Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAuthorized}" Value="True">
                    <Setter Property="IsEnabled" Value="True"></Setter>
                    <Setter Property="Visibility" Value="Visible"></Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ClientFullName" TargetType="TextBox">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAuthorized}" Value="True">
                    <Setter Property="IsReadOnly" Value="True"></Setter>
                    <Setter Property="Text" Value="{Binding ClientUserName, Mode=OneWay}"></Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAuthorized}" Value="False">
                    <Setter Property="IsReadOnly" Value="False"></Setter>
                    <Setter Property="Text" Value="{Binding ClientFullNameWritable, Mode=OneWayToSource}"></Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Дата заказа" FontSize="20" Grid.Row="0" Grid.Column="0"></TextBlock>
        <TextBlock Text="Дата доставки заказа" FontSize="20" Grid.Row="1" Grid.Column="0"></TextBlock>
        <TextBlock Text="ФИО клиента" FontSize="20" Grid.Row="2" Grid.Column="0"></TextBlock>
        <TextBlock Text="Номер заказа" FontSize="20" Grid.Row="3" Grid.Column="0"></TextBlock>

        <DatePicker Grid.Row="0" Grid.Column="1" SelectedDate="{Binding OrderDate, Mode=OneWayToSource}"></DatePicker>
        <DatePicker Grid.Row="1" Grid.Column="1" IsEnabled="False" SelectedDate="{Binding OrderDeliveryDate}"></DatePicker>
        <TextBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" FontSize="20" Style="{StaticResource ClientFullName}"/>
        <TextBlock Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" FontSize="20" Text="{Binding OrderCode, TargetNullValue=''}"></TextBlock>

        <ListView Grid.Row="4" Grid.ColumnSpan="2" ItemsSource="{Binding SelectedProducts}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="1000"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Image Margin="10" Grid.Column="0" Stretch="UniformToFill" HorizontalAlignment="Center" Grid.RowSpan="5" DataContext="{Binding Product}">
                            <Image.Source>
                                <Binding Path="ProductPhotoPath">
                                    <Binding.TargetNullValue>
                                        <ImageSource>/Content/picture.png</ImageSource>
                                    </Binding.TargetNullValue>
                                    <Binding.FallbackValue>
                                        <ImageSource>/Content/picture.png</ImageSource>
                                    </Binding.FallbackValue>
                                </Binding>
                            </Image.Source>
                        </Image>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ProductName}" FontSize="20" DataContext="{Binding Product}"></TextBlock>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProductDescription}" FontSize="20" TextWrapping="Wrap" DataContext="{Binding Product}"></TextBlock>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProductManufacturer}" FontSize="20" DataContext="{Binding Product}"></TextBlock>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProductCost, StringFormat= {}{0} рублей}" FontSize="20" DataContext="{Binding Product}"></TextBlock>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="*Скидка" FontSize="20" HorizontalAlignment="Center"></TextBlock>
                        <TextBlock Grid.Column="2" Grid.Row="2" Text="{Binding ProductDiscountAmount, StringFormat={}{0}%}" FontSize="25" HorizontalAlignment="Center" DataContext="{Binding Product}"/>
                        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="5">
                            <Button Name="MinusBtn" Content="-" Width="30" Click="ProductRemovingClick"/>
                            <TextBlock Name="QuantityTB" Width="50" FontSize="30" Text="{Binding DisplayOrderCount, Mode=TwoWay}"></TextBlock>
                            <Button Name="PlusBtn"  Content="+" Width="30" Click="ProductAddingClick"/>
                            <Button Name="DeleteBtn" Grid.Column="1" Grid.Row="5" Content="Убрать" Width="75" Height="30" Margin="10, 0" HorizontalAlignment="Right" Click="ProductClearClick"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="5" Text="Пункт выдачи" FontSize="20"/>
        <ComboBox Name="PickUpPointCombo" Grid.Column="1" Grid.Row="5" ItemsSource="{Binding PickupPoints}" SelectedValue="{Binding SelectedPickupPoint, Mode=OneWayToSource}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding FullAddress}"/>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <Button Content="Сохранить у пользователя" FontSize="20" Height="auto" Margin="10, 0"
                Click="SaveToUserOrder" Grid.Row="6" Grid.Column="0" Style="{StaticResource AuthRequired}">
        </Button>
        
        <StackPanel Grid.Column="1" Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Сохранить" FontSize="20" Height="auto" Width="120" Margin="10, 0" Click="SaveButtonClick"></Button>
            <Button Grid.Column="1" Grid.Row="6" Content="Отменить" FontSize="20" Height="auto" Width="120" Click="CancelButtonClick"></Button>
            <Button Content="Очистить" FontSize="20" Height="auto" Width="120" Margin="10, 0" Click="CartClearClick"></Button>
        </StackPanel>
    </Grid>

    
</Page>

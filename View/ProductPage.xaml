<Page x:Class="_41Size.View.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_41Size.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="150"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Top">
            <StackPanel.Resources>
                <Style x:Key="CartButtonStyle" TargetType="Button">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding InOrderProductCount}" Value="0">
                            <Setter Property="Visibility" Value="Hidden"></Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding InOrderProductCount}" Value="1">
                            <Setter Property="Visibility" Value="Visible"></Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Resources>
            <WrapPanel HorizontalAlignment="Center" Margin="50, 0">
                <TextBlock Text="Введите название для поиска"></TextBlock>
                <TextBox Width="200" Margin="10, 0" Text="{Binding SearchField, Mode=OneWayToSource}"></TextBox>
            </WrapPanel>
            <WrapPanel HorizontalAlignment="Center" Margin="10">
                <ComboBox Height="30" Width="100" ItemsSource="{Binding DiscountFilterList}" SelectedValue="{Binding DiscountFilter}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <WrapPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Item1, StringFormat='от 0 '}"></TextBlock>
                                    <TextBlock Text="{Binding Item2, StringFormat=до 0}"></TextBlock>
                                </StackPanel>
                            </WrapPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <GroupBox Margin="10">
                    <StackPanel>
                        <RadioButton Content="По возрастанию" Click="SetOrderDirectionUp"></RadioButton>
                        <RadioButton Content="По убыванию" Margin="2, 2, 0, 0" Click="SetOrderDirectionDown"></RadioButton>
                    </StackPanel>
                </GroupBox>
            </WrapPanel>
            <UniformGrid>
                <Button Width="100" Click="OpenCartClick" Grid.Column="0" Margin="10" HorizontalAlignment="Left" Content="Корзина" FontWeight="Bold" Style="{DynamicResource CartButtonStyle}">
                </Button>
                <WrapPanel Grid.Column="1" Width="200">
                    <TextBlock Text="{Binding UserName}" Width="200"></TextBlock>
                    <TextBlock Text="{Binding UserRole}"></TextBlock>
                </WrapPanel>
            </UniformGrid>
            </StackPanel>
        <ListView Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Products}" SelectedValue="{Binding SelectedProduct, Mode=OneWayToSource}">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Добавить к заказу" Click="AddToOrderClick"></MenuItem>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"></ColumnDefinition>
                            <ColumnDefinition Width="500"></ColumnDefinition>
                            <ColumnDefinition Width="180*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="100"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Image Margin="10" Grid.Column="0" Stretch="UniformToFill" HorizontalAlignment="Center" Grid.RowSpan="5">
                            <Image.Source>
                                <Binding Path="ProductPhotoPath">
                                    <Binding.TargetNullValue>
                                        <ImageSource>/Content/picture.png</ImageSource>
                                    </Binding.TargetNullValue>
                                    <Binding.FallbackValue>
                                        <ImageSource>/Content/picture.png</ImageSource>
                                    </Binding.FallbackValue>
                                </Binding>
                            </Image.Source>
                        </Image>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding ProductName}" Margin="2"></TextBlock>
                            <TextBlock Text="{Binding ProductDescription}" Margin="2"></TextBlock>
                            <TextBlock Text="{Binding ProductManufacturer}" Margin="2"></TextBlock>
                            <TextBlock Text="{Binding ProductCost, StringFormat=0.00}" Margin="2"></TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Column="2" FontSize="35" TextAlignment="Center" Text="{Binding ProductDiscountAmount}"></TextBlock>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

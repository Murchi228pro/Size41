<Page x:Class="_41Size.View.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_41Size.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Auth">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition Width="300"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="350"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="1" Grid.Column="1">
            <TextBlock Text="Авторизация" FontSize="20" HorizontalAlignment="Center" Margin="20, 10, 20, 20"></TextBlock>
            <TextBlock Text="Введите логин" Margin="20, 3"></TextBlock>
            <Border Background="Black" Margin="20, 2">
                <TextBox Margin="3, 3" Height="25" Background="White" Text="{Binding LoginField, Mode=OneWayToSource}"></TextBox>
            </Border>
            <TextBlock Text="Введите пароль" Margin="20, 3"></TextBlock>
            <Border Background="Black" Margin="20, 2">
                <TextBox Margin="3, 3" Height="25" Background="White" Text="{Binding PasswordField, Mode=OneWayToSource}" ></TextBox>
            </Border>
            <Image Width="200" Height="40" Margin="15" Name="CaptchaImage">
            </Image>
            <TextBox Width="150" Text="{Binding CaptchaField}"></TextBox>
            <Button Content="Подтвердить" Margin="35, 15, 35, 0" Click="TryLogin">
            </Button>
            <TextBlock Text="Войти как гость" TextAlignment="Center" Foreground="CadetBlue" MouseUp="LoginAsVisitor"></TextBlock>
            <TextBlock Margin="10" Height="36" Text="{Binding LogInfo, NotifyOnSourceUpdated=True, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" Foreground="Red"></TextBlock>
        </StackPanel>
    </Grid>
</Page>
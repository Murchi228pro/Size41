<Page x:Class="_41Size.View.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_41Size.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminPage">
    <Page.Resources>
        <Style x:Key="OnSubWindowOpen" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSubWindowOpened, NotifyOnSourceUpdated=True, UpdateSourceTrigger=PropertyChanged}" Value="True" >
                    <Setter Property="IsEnabled" Value="False"></Setter>
                    <Setter Property="Opacity" Value="0.5"></Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSubWindowOpened, NotifyOnSourceUpdated=True, UpdateSourceTrigger=PropertyChanged}" Value="False">
                    <Setter Property="IsEnabled" Value="True"></Setter>
                    <Setter Property="Opacity" Value="1"></Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="5">
                <TextBlock Text="{Binding Admin.UserFullName}"></TextBlock>
                <TextBlock Text="{Binding Admin.UserRoleNavigation.RoleName}"></TextBlock>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1" Grid.RowSpan="2">
                
            </StackPanel>
        </Grid>
        <ListView ItemsSource="{Binding Orders}" Grid.Row="1" SelectedValue="{Binding SelectedOrder}">
            <ListView.ContextMenu>
                <ContextMenu>
                    <Button Content="Редактировать" Grid.Row ="0" Grid.Column="4" HorizontalAlignment="Right" Style="{DynamicResource OnSubWindowOpen}" Click="EditWindowOpen_Click" Width="100"></Button>
                    <Button Content="Удалить" Grid.Row ="1" Grid.Column="4" HorizontalAlignment="Right" Style="{DynamicResource OnSubWindowOpen}" Click="RemoveOrder_Click" Width="100"></Button>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Height="50">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"></ColumnDefinition>
                            <ColumnDefinition Width="200"></ColumnDefinition>
                            <ColumnDefinition Width="100"></ColumnDefinition>
                            <ColumnDefinition Width="200"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding OrderGetCode}" Grid.Row="0" Grid.Column="0" FontSize="20"></TextBlock>
                        <TextBlock Text="{Binding OrderDate}" Grid.Row="1" Grid.Column="0"></TextBlock>
                        <TextBlock Text="{Binding OrderClientName}" Grid.Row="1" Grid.Column="1"></TextBlock>
                        <TextBlock Text="{Binding OrderSum, StringFormat=0.00}" Grid.Row="1" Grid.Column="2"></TextBlock>
                        <TextBlock Text="{Binding PickupPoint.FullAddress, FallbackValue='Null'}" Grid.Row="1" Grid.Column="3"></TextBlock>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

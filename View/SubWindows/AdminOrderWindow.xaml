<Window x:Class="_41Size.View.SubWindows.AdminOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_41Size.View.SubWindows"
        mc:Ignorable="d"
        Title="AdminOrderWindow" Height="400" Width="660">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition Width="200"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="100"></RowDefinition>
        </Grid.RowDefinitions>
        <ListView ItemsSource="{Binding OrderItems}" Grid.RowSpan="2">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Height="150">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"></ColumnDefinition>
                            <ColumnDefinition Width="230"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <Image Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" Grid.RowSpan="3" Width="100" Height="100" Margin="4" Stretch="Uniform">
                            <Image.Source>
                                <Binding Path="Product.ProductPhotoPath">
                                    <Binding.TargetNullValue>
                                        <ImageSource>/Content/picture.png</ImageSource>
                                    </Binding.TargetNullValue>
                                    <Binding.FallbackValue>
                                        <ImageSource>/Content/picture.png</ImageSource>
                                    </Binding.FallbackValue>
                                </Binding>
                            </Image.Source>
                        </Image>
                        <TextBlock Text="{Binding Product.ProductName}" Grid.Column="1" Grid.Row="0"></TextBlock>
                        <TextBlock Text="{Binding Product.ProductDescription}" TextWrapping="Wrap" Grid.Column="1" Grid.Row="1"></TextBlock>
                        <TextBlock Text="{Binding Product.ProductPrice}" Grid.Column="1" Grid.Row="2"></TextBlock>
                        <TextBlock Text="{Binding OrderCount, StringFormat=0 Шт}" Grid.Column="2" Grid.Row="0"></TextBlock>
                        <Button Content="Удалить" Click="RemoveItemButton_Click" Grid.Column="2" Grid.Row="2" FontSize="8" Style="{StaticResource ButtonBase}"></Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10">
            <TextBlock Text="Дата заказа" FontSize="8"></TextBlock>
            <DatePicker SelectedDate="{Binding EditableOrder.OrderDateDisplay}"></DatePicker>
            <TextBlock Text="Дата доставки" FontSize="8"></TextBlock>
            <DatePicker SelectedDate="{Binding EditableOrder.OrderDeliveryDateDisplay}"></DatePicker>
            <TextBlock Text="{Binding OrderSum, StringFormat='Общая сумма: 0.00'}" Height="20" Margin="4"></TextBlock>
            <TextBlock Text="{Binding OrderDiscountSum, StringFormat='Общая скидка: 0.00'}" Height="20" Margin="4"></TextBlock>
            <TextBlock Text="{Binding OrderSumWithDiscount, StringFormat='Итог: 0.00'}" Height="20" Margin="4"></TextBlock>
        </StackPanel>
        <WrapPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="200">
            <WrapPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}">
                    <Setter Property="Width" Value="160"></Setter>
                    <Setter Property="Height" Value="30"></Setter>
                    <Setter Property="Margin" Value="20, 4, 0, 4"></Setter>
                    <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                </Style>
            </WrapPanel.Resources>
            <Button Content="Сохранить" Click="SaveButton_Click"></Button>
            <Button Content="Закрыть" Click="CloseButton_Click"></Button>
        </WrapPanel>
    </Grid>
</Window>
